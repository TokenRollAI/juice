direction: right

title: {
  label: "Juice UI Architecture (v0.2 — 28 Blocks, 12 Procedural Sounds & Agent Bridge)"
  near: top-center
  shape: text
  style.font-size: 22
  style.bold: true
}

foundation: "1. Foundation & Tokens (@juice-ui/react)" {
  tokens: "Concentric CSS Tokens\n(--fill-on / --fill-slab + 6-step color-mix ramp)"
  sound: "Procedural Web Audio Synth\n(12 zero-asset oscillator + filter sounds)"
  behaviors: "Headless Behaviors & Agent Bridge\n(ControllableState / RovingFocus / ScrubDrag / __juiceAgent)"
}

catalog: "2. 28-Block Three-Pillar Catalog" {
  tactile: "Tactile & Direct Manipulation (13)\nStateButton, ScrubPanel, SlideConfirm, DynamicIsland, MorphCard,\nSplitCompare, OtpField, PassStrength, TimeSlotPicker, RadialDial,\nSwipeCard, SelectionToolbar, CommandPalette"
  workspace: "High-Density Workspace Surfaces (8)\nDataGrid (InlineEdit), TreeExplorer, ResizableSplit, FilterBar,\nDrawerSheet (Vaul), TabsMorph, TransferList, ToastStack"
  ai_data: "AI, Data & Media Narrative (7)\nComposer, ThinkingMorph, RollingNumber, MetricRibbon,\nAudioWaveTrim, CodeDiffReveal, SkeletonMorph"
}

consumers: "3. Independent Consumers" {
  bench: "Juice Bench (apps/bench)\n28 Live Blocks, Search, Sound Pad & act() Inspector"
  webapp: "Production Web & AI Apps\nDirect React Import + Agent Skill (skills/juice)"
  joplo: "Joplo Host Adapter (Ready Bridge)\nMaps data-jid, state.inputs & Engine Clock (animate=false)"
}

foundation.tokens -> catalog.tactile: "Derives light/dark & slab/solid ramps"
foundation.tokens -> catalog.workspace: "Concentric radii (20px -> 14px -> 10px)"
foundation.sound -> catalog.tactile: "Fires tap / latch / scrub / paid / landed cues"
foundation.behaviors -> catalog.tactile: "Exposes controlled props & data-state slots"
foundation.behaviors -> catalog.workspace: "Keyboard roving focus, inline edit & resize"
foundation.behaviors -> catalog.ai_data: "Deterministic state & digit transitions"

catalog.tactile -> consumers.bench: "Live playable blocks on canvas"
catalog.workspace -> consumers.bench: "Live inspectable state machine"
catalog.ai_data -> consumers.bench: "Interactive diff, trim & number scrub"

catalog.tactile -> consumers.webapp: "1:1 production components"
catalog.ai_data -> consumers.webapp: "1:1 AI agent interfaces"

foundation.behaviors -> consumers.joplo: "snapshot() / act() + controlled value props"
foundation.tokens -> consumers.joplo: "Maps --jp-ink & --jp-surface to --fill-on & --fill-slab"
