{
  "name": "@tokenroll/juice",
  "version": "0.3.0",
  "description": "Tactile, behavior-complete React UI components, Radix & Base UI primitives, AI agent workflows, concentric color-mix tokens, and procedural Web Audio sounds.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://juice.tokenroll.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TokenRollAI/juice.git",
    "directory": "packages/juice"
  },
  "bugs": {
    "url": "https://github.com/TokenRollAI/juice/issues"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "radix",
    "base-ui",
    "ai-components",
    "agent-ui",
    "micro-interactions",
    "web-audio",
    "tokenroll"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "bin": {
    "juice": "./bin/juice.mjs"
  },
  "files": [
    "dist",
    "bin",
    "src",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./primitives": {
      "types": "./dist/primitives.d.ts",
      "import": "./dist/primitives.js",
      "default": "./dist/primitives.js"
    },
    "./blocks": {
      "types": "./dist/blocks.d.ts",
      "import": "./dist/blocks.js",
      "default": "./dist/blocks.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./scoped.css": "./dist/scoped.css",
    "./layered.css": "./dist/layered.css"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ../../scripts/bundle-css.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "1.66.0",
    "motion": "14.9.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
