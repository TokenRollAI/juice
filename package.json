{
  "name": "juice-monorepo",
  "version": "0.2.0",
  "description": "Juice — Tactile, behavior-driven React & Vue 3 UI blocks, micro-interactions, and procedural sound for modern products and AI agents.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @tokenroll/juice-site dev",
    "build:packages": "pnpm --filter @tokenroll/juice build && pnpm --filter @tokenroll/juice-vue build",
    "build:site": "pnpm --filter @tokenroll/juice-site build",
    "build": "pnpm build:packages && pnpm build:site",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
