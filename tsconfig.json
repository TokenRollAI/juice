{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": false,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "isolatedModules": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["packages/*/src/**/*", "apps/*/src/**/*"]
}
